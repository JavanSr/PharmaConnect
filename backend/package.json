{
  "name": "pharmaconnect-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --prefer-ts-exts src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "railway:start": "echo Starting PharmaConnect API && node dist/index.js",
    "test": "vitest run --coverage",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed:trial-stock": "ts-node prisma/seed-trial-stock.ts",
    "db:seed:drug": "ts-node prisma/seed-drug-database.ts",
    "db:seed:master-catalog": "ts-node prisma/seed-master-catalog.ts",
    "db:seed:demo": "ts-node prisma/seed-demo-data.ts",
    "seed:drugs": "ts-node prisma/seed-drug-database.ts",
    "seed:master-catalog": "ts-node prisma/seed-master-catalog.ts",
    "import:public-products": "ts-node prisma/import-public-product-scrape-fast.ts",
    "backfill:public-product-brands": "ts-node prisma/backfill-public-product-brands.ts",
    "source-sync:check": "ts-node prisma/check-source-updates.ts",
    "scrape:public-products": "python scripts/scrape_public_product_sources.py",
    "db:cleanup": "ts-node prisma/cleanup-non-seed-data.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@prisma/client": "^5.13.0",
    "@supabase/auth-js": "^2.103.0",
    "@supabase/supabase-js": "^2.103.0",
    "africastalking": "^0.7.9",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.18.0",
    "resend": "^6.12.2",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "axios": "^1.18.1",
    "lodash": "^4.18.1"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/pdfkit": "^0.17.5",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.8",
    "@vitest/coverage-v8": "^4.1.4",
    "prisma": "^5.13.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.4"
  }
}
