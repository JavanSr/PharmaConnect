generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  PHARMACIST_IN_CHARGE
  DISPENSER
  DATA_ENTRY_CLERK
  WHOLESALE_ADMIN
  WHOLESALE_SELLER
  SUPER_ADMIN
}

enum PharmacyType {
  RETAIL
  ADDO
  WHOLESALE
}

enum SubscriptionTier {
  FREE
  ADDO_PLUS
  STANDARD
  PREMIUM
  WHOLESALE
}

enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum StorageCondition {
  AMBIENT
  REFRIGERATED
  FROZEN
}

enum MovementType {
  RECEIVED
  DISPENSED
  ADJUSTED
  DAMAGED
  RETURNED
  EXPIRED_REMOVED
  DONATED
  TRANSFERRED
}

enum ComplianceType {
  TMDA_PREMISE
  PC_IN_CHARGE
  PC_TECHNOLOGIST
  DLDM_CERT
  COLD_CHAIN
  NARCOTICS
  BUSINESS_LICENCE
  CUSTOM
}

enum ComplianceStatus {
  GREEN
  AMBER
  RED
  EXPIRED
}

enum InteractionSeverity {
  MINOR
  MODERATE
  MAJOR
  CONTRAINDICATED
}

enum PregnancyCategory {
  A
  B
  C
  D
  X
}

enum CpdActivityType {
  READING
  WEBINAR
  CONFERENCE
  WORKSHOP
  SELF_STUDY
}

enum NhifClaimStatus {
  DRAFT
  SCRUBBED
  SUBMITTED
  APPROVED
  REJECTED
  RESUBMITTED
}

enum PaymentMethod {
  CASH
  MPESA
  TIGOPESA
  AIRTEL_MONEY
  HALOPESA
  INSURANCE
}

enum AlertChannel {
  SMS
  EMAIL
  IN_APP
}

enum SyncConflictStatus {
  PENDING
  RESOLVED
}

// ─── MODELS ───────────────────────────────────────────────────────────────────

model Pharmacy {
  id               String           @id @default(cuid())
  name             String
  licenceNumber    String
  address          String
  region           String
  pharmacyType     PharmacyType
  subscriptionTier SubscriptionTier
  ownerId          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  users            User[]
  products         Product[]
  batches          Batch[]
  complianceItems  ComplianceItem[]
  nhifClaims       NhifClaim[]
  dispensingEvents DispensingEvent[]
  patients         Patient[]
  stockMovements   StockMovement[]
  suppliers        Supplier[]
  staffCredentials StaffCredential[]
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  firstName            String
  lastName             String
  role                 UserRole
  pharmacyId           String?
  pcRegistrationNumber String?
  isActive             Boolean   @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  pharmacy         Pharmacy?         @relation(fields: [pharmacyId], references: [id])
  refreshTokens    RefreshToken[]
  sessions         Session[]
  stockMovements   StockMovement[]
  dispensingEvents DispensingEvent[]
  articles         Article[]
  cpdActivities    CpdActivity[]
  staffCredentials StaffCredential[]
  complianceItems  ComplianceItem[]  @relation("AssignedStaff")
  auditLogs        AuditLog[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  isRevoked Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  deviceInfo   String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Article {
  id                 String        @id @default(cuid())
  title              String
  slug               String        @unique
  body               Json
  category           String
  tags               String[]
  status             ArticleStatus @default(DRAFT)
  isSponsored        Boolean       @default(false)
  sponsorName        String?
  sponsorDisplayDate DateTime?
  featuredImage      String?
  readingTimeMinutes Int           @default(1)
  authorId           String
  publishedAt        DateTime?
  scheduledFor       DateTime?
  viewCount          Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  author        User          @relation(fields: [authorId], references: [id])
  cpdActivities CpdActivity[]
}

model Subscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  subscribedAt     DateTime @default(now())
  isActive         Boolean  @default(true)
  unsubscribeToken String   @unique
}

model DrugMaster {
  id                     String           @id @default(cuid())
  tmdaRegistrationNumber String           @unique
  genericName            String
  brandName              String?
  manufacturer           String?
  drugClass              String?
  dosageForm             String?
  strength               String?
  unitOfMeasure          String           @default("units")
  packSize               Int              @default(1)
  storageCondition       StorageCondition @default(AMBIENT)
  isColdChain            Boolean          @default(false)
  isEssentialMedicine    Boolean          @default(false)
  isActive               Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  products Product[]

  @@index([genericName])
  @@index([tmdaRegistrationNumber])
}

model Product {
  id                     String           @id @default(cuid())
  name                   String
  genericName            String?
  brandName              String?
  drugClass              String?
  description            String?
  sku                    String?
  barcode                String?
  dosageForm             String?
  strength               String?
  unitOfMeasure          String           @default("units")
  packSize               Int              @default(1)
  storageCondition       StorageCondition @default(AMBIENT)
  isColdChain            Boolean          @default(false)
  tmdaRegistrationNumber String?
  sellingPrice           Float?
  purchasePriceDefault   Float?
  reorderLevel           Int              @default(10)
  minStock               Int              @default(5)
  isActive               Boolean          @default(true)
  pharmacyId             String
  drugMasterId           String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  pharmacy       Pharmacy        @relation(fields: [pharmacyId], references: [id])
  drugMaster     DrugMaster?     @relation(fields: [drugMasterId], references: [id])
  batches        Batch[]
  stockMovements StockMovement[]
}

model Batch {
  id                String   @id @default(cuid())
  productId         String
  batchNumber       String
  expiryDate        DateTime
  quantityRemaining Int
  purchasePrice     Float
  supplierId        String?
  receivedAt        DateTime @default(now())
  pharmacyId        String

  product          Product           @relation(fields: [productId], references: [id])
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  pharmacy         Pharmacy          @relation(fields: [pharmacyId], references: [id])
  stockMovements   StockMovement[]
  dispensingEvents DispensingEvent[]
}

model StockMovement {
  id              String       @id @default(cuid())
  productId       String
  batchId         String?
  type            MovementType
  quantity        Int
  previousBalance Int
  newBalance      Int
  referenceNumber String?
  reason          String?
  notes           String?
  userId          String
  pharmacyId      String
  createdAt       DateTime     @default(now())

  product  Product  @relation(fields: [productId], references: [id])
  batch    Batch?   @relation(fields: [batchId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  pharmacyId    String
  createdAt     DateTime @default(now())

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])
  batches  Batch[]
}

model SyncConflict {
  id         String             @id @default(cuid())
  table      String
  recordId   String
  localData  Json
  serverData Json
  status     SyncConflictStatus @default(PENDING)
  resolvedAt DateTime?
  createdAt  DateTime           @default(now())
}

model AlertLog {
  id         String       @id @default(cuid())
  type       String
  targetId   String
  channel    AlertChannel
  sentAt     DateTime     @default(now())
  pharmacyId String
  metadata   Json?
}

model ComplianceItem {
  id              String           @id @default(cuid())
  type            ComplianceType
  name            String
  issuingBody     String
  licenceNumber   String?
  issueDate       DateTime?
  expiryDate      DateTime
  status          ComplianceStatus @default(GREEN)
  notes           String?
  isNotApplicable Boolean          @default(false)
  pharmacyId      String
  assignedStaffId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  pharmacy      Pharmacy             @relation(fields: [pharmacyId], references: [id])
  assignedStaff User?                @relation("AssignedStaff", fields: [assignedStaffId], references: [id])
  documents     ComplianceDocument[]
  alerts        ComplianceAlert[]
}

model ComplianceDocument {
  id               String   @id @default(cuid())
  complianceItemId String
  filename         String
  fileUrl          String
  fileSize         Int
  uploadedAt       DateTime @default(now())

  complianceItem ComplianceItem @relation(fields: [complianceItemId], references: [id])
}

model StaffCredential {
  id                 String   @id @default(cuid())
  userId             String
  credentialType     String
  registrationNumber String
  expiryDate         DateTime
  pharmacyId         String

  user     User     @relation(fields: [userId], references: [id])
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])
}

model ComplianceAlert {
  id               String       @id @default(cuid())
  complianceItemId String
  triggeredAt      DateTime     @default(now())
  channel          AlertChannel
  daysBeforeExpiry Int
  delivered        Boolean      @default(false)
  deliveredAt      DateTime?

  complianceItem ComplianceItem @relation(fields: [complianceItemId], references: [id])
}

model InspectionChecklist {
  id                String   @id @default(cuid())
  pharmacyId        String
  items             Json
  generatedAt       DateTime @default(now())
  generatedByUserId String
  pdfUrl            String?
}

model Patient {
  id                String    @id @default(uuid())
  chronicConditions String[]
  allergyFlags      Json      @default("{}")
  activeMedications String[]
  optInStatus       Boolean   @default(false)
  optInTimestamp    DateTime?
  optInMethod       String?
  createdAt         DateTime  @default(now())
  pharmacyId        String

  pharmacy            Pharmacy             @relation(fields: [pharmacyId], references: [id])
  dispensingEvents    DispensingEvent[]
  nhifClaims          NhifClaim[]
  prescriptionRecords PrescriptionRecord[]
}

model PrescriptionRecord {
  id                String   @id @default(cuid())
  patientId         String
  mrn               String
  dispensingEventId String?
  createdAt         DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
}

model DispensingEvent {
  id                String        @id @default(cuid())
  patientId         String
  drugId            String
  batchId           String?
  quantity          Int
  dose              String?
  icdCode           String?
  counsellingNotes  String?
  dispensedByUserId String
  pharmacyId        String
  dispensedAt       DateTime      @default(now())
  isVoided          Boolean       @default(false)
  voidReason        String?
  voidedAt          DateTime?
  voidedByUserId    String?
  vfdReceiptNumber  String?
  vfdStatus         String        @default("PENDING")
  paymentMethod     PaymentMethod @default(CASH)
  paymentRef        String?

  patient           Patient               @relation(fields: [patientId], references: [id])
  drug              DrugDatabase          @relation(fields: [drugId], references: [id])
  batch             Batch?                @relation(fields: [batchId], references: [id])
  pharmacy          Pharmacy              @relation(fields: [pharmacyId], references: [id])
  dispensedBy       User                  @relation(fields: [dispensedByUserId], references: [id])
  nhifClaim         NhifClaim?
  interactionAlerts InteractionAlertLog[]
}

model DrugInteraction {
  id                  String              @id @default(cuid())
  drugAId             String
  drugBId             String
  severity            InteractionSeverity
  description         String
  clinicalConsequence String?
  management          String?

  drugA DrugDatabase @relation("DrugA", fields: [drugAId], references: [id])
  drugB DrugDatabase @relation("DrugB", fields: [drugBId], references: [id])
}

model DrugContraindication {
  id                String             @id @default(cuid())
  drugId            String
  condition         String
  pregnancyCategory PregnancyCategory?
  breastfeedingSafe Boolean            @default(true)
  elderlyFlag       Boolean            @default(false)
  renalFlag         Boolean            @default(false)
  hepaticFlag       Boolean            @default(false)

  drug DrugDatabase @relation(fields: [drugId], references: [id])
}

model DrugDatabase {
  id                     String   @id @default(cuid())
  genericName            String
  brandNames             String[]
  drugClass              String?
  atcCode                String?
  tmdaRegistrationNumber String?
  standardDosing         Json     @default("{}")
  isOTC                  Boolean  @default(false)
  isControlled           Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  version                Int      @default(1)

  interactions_a    DrugInteraction[]      @relation("DrugA")
  interactions_b    DrugInteraction[]      @relation("DrugB")
  contraindications DrugContraindication[]
  dispensingEvents  DispensingEvent[]
}

model InteractionAlertLog {
  id                String              @id @default(cuid())
  dispensingEventId String
  drugAId           String
  drugBId           String
  severity          InteractionSeverity
  overridePin       String?
  overrideReason    String?
  overrideUserId    String?
  alertedAt         DateTime            @default(now())

  dispensingEvent DispensingEvent @relation(fields: [dispensingEventId], references: [id])
}

model NhifClaim {
  id                  String          @id @default(cuid())
  dispensingEventId   String          @unique
  patientId           String
  pharmacyId          String
  nhifCardNumber      String
  memberName          String?
  memberStatus        String?
  scheme              String?
  icdCode             String
  drugCode            String?
  quantity            Int
  claimedAmount       Float
  status              NhifClaimStatus @default(DRAFT)
  nhifReferenceNumber String?
  rejectionCode       String?
  rejectionReason     String?
  submittedAt         DateTime?
  approvedAt          DateTime?
  vfdReceiptNumber    String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  dispensingEvent DispensingEvent    @relation(fields: [dispensingEventId], references: [id])
  patient         Patient            @relation(fields: [patientId], references: [id])
  pharmacy        Pharmacy           @relation(fields: [pharmacyId], references: [id])
  scrubResults    ClaimScrubResult[]
}

model ClaimBatch {
  id                 String    @id @default(cuid())
  pharmacyId         String
  status             String    @default("PENDING")
  claimIds           String[]
  submittedAt        DateTime?
  nhifBatchReference String?
  totalClaims        Int       @default(0)
  totalAmount        Float     @default(0)
  createdAt          DateTime  @default(now())
}

model ClaimScrubResult {
  id           String   @id @default(cuid())
  claimId      String
  rule         String
  passed       Boolean
  errorMessage String?
  checkedAt    DateTime @default(now())

  claim NhifClaim @relation(fields: [claimId], references: [id])
}

model NhifApiLog {
  id           String   @id @default(cuid())
  endpoint     String
  method       String
  requestBody  Json?
  responseBody Json?
  statusCode   Int?
  durationMs   Int?
  createdAt    DateTime @default(now())
}

model WaitlistSignup {
  id         String   @id @default(cuid())
  email      String
  module     String
  phase      Int
  signedUpAt DateTime @default(now())
}

model CpdActivity {
  id              String          @id @default(cuid())
  userId          String
  activityType    CpdActivityType
  title           String
  activityDate    DateTime
  pointsClaimed   Int
  evidenceFileUrl String?
  renewalYear     Int
  sourceArticleId String?
  createdAt       DateTime        @default(now())

  user          User     @relation(fields: [userId], references: [id])
  sourceArticle Article? @relation(fields: [sourceArticleId], references: [id])
}

model CpdRequirement {
  id             String @id @default(cuid())
  renewalYear    Int    @unique
  requiredPoints Int    @default(20)
  country        String @default("TZ")
}

model ICD10Code {
  id          String  @id @default(cuid())
  code        String  @unique
  description String
  category    String?
}
