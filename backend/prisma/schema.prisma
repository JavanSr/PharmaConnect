// APOTEKH — Prisma Schema
// Database: PostgreSQL (Railway or Supabase)
// Generated: 2026-04

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  OWNER
  PHARMACIST_IN_CHARGE
  DISPENSER
  LOCUM
  CASHIER
  WHOLESALE_MANAGER
  WHOLESALE_COUNTER_STAFF
  DELIVERY_STAFF
  WHOLESALE_SELLER
}

enum PharmacyMembershipRole {
  OWNER
  PHARMACIST_IN_CHARGE
  DISPENSER
  LOCUM
}

enum SubscriptionTier {
  FREE
  ADDO
  ESSENTIAL
  ADDO_PLUS
  STANDARD
  PREMIUM
  WHOLESALE
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum PharmacyAccountStatus {
  TRIAL
  ACTIVE
  GRACE
  SUSPENDED
  CANCELLED
}

enum SubscriptionPaymentRequestStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum PharmacyType {
  RETAIL
  ADDO
  WHOLESALE
}

enum DrugClass {
  OTC
  PRESCRIPTION
  CONTROLLED
  NARCOTIC
}

enum DosageForm {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  CREAM
  OINTMENT
  DROPS
  INHALER
  SUPPOSITORY
  POWDER
  SOLUTION
  OTHER
}

enum MovementType {
  RECEIVED
  DISPENSED
  ADJUSTED
  DAMAGED
  EXPIRED_REMOVED
  RETURNED
  TRANSFERRED
}

enum ComplianceCategory {
  LICENCE
  INSURANCE
  EQUIPMENT
  STAFF_CREDENTIAL
  SAFETY
  RECORD_KEEPING
  OTHER
}

enum ComplianceStatus {
  GREEN
  AMBER
  RED
  EXPIRED
}

enum CpdActivityType {
  READING
  WORKSHOP
  CONFERENCE
  ONLINE_COURSE
  MENTORING
  AUDIT
  OTHER
}

enum ArticleCategory {
  DRUG_SAFETY
  REGULATORY
  CLINICAL
  BUSINESS
  TECHNOLOGY
  CPD
  GENERAL
}

enum PaymentMethod {
  CASH
  MPESA
  TIGOPESA
  AIRTEL_MONEY
  HALOPESA
  INSURANCE
}

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
  WHATSAPP
}


enum SourceDocumentType {
  PRODUCT_REGISTER
  SMPC
  TPAR
  NEMLIT
  MSD_CATALOGUE
  WHO_EML
  WHO_MODEL_FORMULARY
  BNF
  STG
  ADDENDUM
  MANUAL_ENTRY
  OTHER
}

enum SourceTrustLevel {
  OFFICIAL_PRIMARY
  OFFICIAL_SECONDARY
  PROCUREMENT_PRIMARY
  INTERNATIONAL_FALLBACK
  MANUAL_REVIEW
}

enum ImportMethod {
  API_SYNC
  HTML_SCRAPE
  PDF_EXTRACTION
  CSV_IMPORT
  XLSX_IMPORT
  MANUAL_ENTRY
}

enum ReviewStatus {
  DRAFT
  IMPORTED
  NEEDS_VERIFICATION
  REVIEWED
  APPROVED
  REJECTED
  RETIRED
}

enum ReviewQueueStatus {
  DRAFT
  IMPORTED
  PENDING_REVIEW
  APPROVED
  REJECTED
  RETIRED
}

enum AliasType {
  BRAND
  GENERIC
  SPELLING_VARIANT
  MSD_CODE
  TMDA_REGISTRATION
  LOCAL_NAME
}

enum ReviewerType {
  PLATFORM_PHARMACIST
  TMDA_REFERENCE
}

enum SourceSyncStatus {
  STARTED
  COMPLETED
  FAILED
}

enum SourceSyncChangeType {
  NEW_SOURCE
  SOURCE_METADATA_UPDATED
  SOURCE_UNCHANGED
  SOURCE_CHECK_FAILED
  SOURCE_NOT_MONITORED
}

enum PharmacyLinkStatus {
  PENDING
  ACTIVE
  REJECTED
  DISSOLVED
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum SubscriptionInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOIDED
}

// ─── Core Models ─────────────────────────────────────────────────────────────

model Pharmacy {
  id                    String                @id @default(uuid())
  name                  String
  licenceNumber         String                @unique
  address               String
  region                String
  pharmacyType          PharmacyType          @default(RETAIL)
  isActive              Boolean               @default(true)
  subscriptionTier      SubscriptionTier      @default(STANDARD) @map("subscription_tier")
  billingCycle          BillingCycle          @default(MONTHLY) @map("billing_cycle")
  status                PharmacyAccountStatus @default(TRIAL)
  trialActive           Boolean               @default(true) @map("trial_active")
  trialStartsAt         DateTime              @default(now()) @map("trial_starts_at")
  trialEndsAt           DateTime              @default(dbgenerated("now() + interval '14 days'")) @map("trial_ends_at")
  isHybrid              Boolean               @default(false) @map("is_hybrid")
  hybridAddonActive     Boolean               @default(false) @map("hybrid_addon_active")
  hybridEnabledAt       DateTime?             @map("hybrid_enabled_at")
  finNumber             String?               @map("fin_number")
  isVerified            Boolean               @default(false) @map("is_verified")
  renewalYear           Int                   @default(2026) @map("renewal_year")
  vfdEnabled            Boolean               @default(false) @map("vfd_enabled")
  timezone              String                @default("Africa/Nairobi")
  userLimit             Int                   @default(4) @map("user_limit")
  subscriptionUpdatedAt DateTime              @default(now()) @map("subscription_updated_at")
  graceActivatedAt      DateTime?             @map("grace_activated_at")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  users                      User[]
  products                   Product[]
  batches                    Batch[]
  suppliers                  Supplier[]
  stockMovements             StockMovement[]
  syncConflicts              SyncConflict[]
  complianceItems            ComplianceItem[]
  complianceAlerts           ComplianceAlert[]
  staffCredentials           StaffCredential[]
  inspectionChecklists       InspectionChecklist[]
  overrideLogs               OverrideLog[]
  notifications              Notification[]
  settings                   PharmacySetting[]
  stockAdjustmentSuggestions StockAdjustmentSuggestion[]
  productBarcodeMappings     ProductBarcodeMapping[]
  barcodeScanTelemetry       BarcodeScanTelemetry[]
  coldChainLogs              ColdChainLog[]
  adverseReactionReports     AdverseReactionReport[]
  stockOrders                StockOrder[]
  supplierPortalTokens       SupplierPortalToken[]
  chatThreads                ChatThread[]
  memberships                PharmacyMembership[]
  aiCounsellingCache         AiCounsellingCache[]
  featureTelemetry           FeatureTelemetry[]
  prescriptions              Prescription[]
  dispensingTransactions     DispensingTransaction[]
  safetyEvents               SafetyEvent[]
  subscriptionPaymentRequests SubscriptionPaymentRequest[]
  wholesalerSuppliers        Supplier[]                   @relation("WholesalerSuppliers")
  cachedCatalogues           SupplierCatalogue[]          @relation("RetailPharmacyCachedCatalogues")
  retailLinks                PharmacyLink[]               @relation("RetailLinks")
  wholesaleLinks             PharmacyLink[]               @relation("WholesaleLinks")
  subscriptionInvoices       SubscriptionInvoice[]

  @@map("pharmacies")
}

model User {
  id                   String    @id @default(uuid())
  pharmacyId           String?   @map("last_pharmacy_id")
  email                String    @unique
  password             String
  firstName            String
  lastName             String
  role                 UserRole  @default(DISPENSER)
  phone                String?
  picPinHash               String?   @map("pic_pin_hash")
  lastPasswordChangeAt     DateTime? @map("last_password_change_at")
  mustChangePassword       Boolean   @default(false) @map("must_change_password")
  isActive                 Boolean   @default(true)
  lastLogin                DateTime?
  emailVerifiedAt          DateTime? @map("email_verified_at")
  emailVerificationToken   String?   @unique @map("email_verification_token") @db.VarChar(64)
  emailVerificationExpiry  DateTime? @map("email_verification_expiry")
  passwordResetToken       String?   @unique @map("password_reset_token") @db.VarChar(64)
  passwordResetExpiry      DateTime? @map("password_reset_expiry")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  pharmacy                           Pharmacy?                   @relation(fields: [pharmacyId], references: [id])
  stockMovements                     StockMovement[]
  cpdActivities                      CpdActivity[]
  articles                           Article[]                   @relation("AuthoredArticles")
  submittedArticles                  Article[]                   @relation("SubmittedArticles")
  chatThreads                        ChatThread[]                @relation("ChatThreadAuthor")
  chatMessages                       ChatMessage[]               @relation("ChatMessageAuthor")
  refreshTokens                      RefreshToken[]
  resolvedSyncConflicts              SyncConflict[]              @relation("ResolvedSyncConflicts")
  uploadedComplianceDocuments        ComplianceDocument[]        @relation("UploadedComplianceDocuments")
  complianceAlertRecipients          ComplianceAlert[]           @relation("ComplianceAlertRecipients")
  staffCredentials                   StaffCredential[]
  generatedInspectionChecklists      InspectionChecklist[]       @relation("GeneratedInspectionChecklists")
  notifications                      Notification[]
  overrideLogs                       OverrideLog[]               @relation("OverrideLogUser")
  approvedOverrides                  OverrideLog[]               @relation("OverrideLogPicUser")
  createdSettings                    PharmacySetting[]           @relation("PharmacySettingCreatedBy")
  createdStockAdjustmentSuggestions  StockAdjustmentSuggestion[] @relation("StockAdjustmentSuggestionCreatedBy")
  reviewedStockAdjustmentSuggestions StockAdjustmentSuggestion[] @relation("StockAdjustmentSuggestionReviewedBy")
  createdProductBarcodeMappings      ProductBarcodeMapping[]     @relation("ProductBarcodeMappingCreatedBy")
  createdBarcodeScanTelemetry        BarcodeScanTelemetry[]      @relation("BarcodeScanTelemetryCreatedBy")
  coldChainLogs                      ColdChainLog[]
  adverseReactionReports             AdverseReactionReport[]
  createdStockOrders                 StockOrder[]                @relation("StockOrderCreatedBy")
  memberships                        PharmacyMembership[]        @relation("UserPharmacyMemberships")
  createdMemberships                 PharmacyMembership[]        @relation("PharmacyMembershipCreatedBy")
  createdAiCounsellingCache          AiCounsellingCache[]        @relation("AiCounsellingCacheCreatedBy")
  createdFeatureTelemetry            FeatureTelemetry[]          @relation("FeatureTelemetryCreatedBy")
  prescriptions                      Prescription[]              @relation("PrescriptionCreatedBy")
  dispensingTransactions             DispensingTransaction[]      @relation("DispensingTransactionCreatedBy")
  safetyEvents                       SafetyEvent[]               @relation("SafetyEventUser")
  createdSubscriptionPaymentRequests SubscriptionPaymentRequest[] @relation("SubscriptionPaymentRequestCreatedBy")
  reviewedSubscriptionPaymentRequests SubscriptionPaymentRequest[] @relation("SubscriptionPaymentRequestReviewedBy")

  @@map("users")
}

model SubscriptionPaymentRequest {
  id                 String                           @id @default(uuid())
  pharmacyId         String                           @map("pharmacy_id")
  requestedBy        String                           @map("requested_by")
  requestedTier      SubscriptionTier                 @map("requested_tier")
  billingCycle       BillingCycle                     @map("billing_cycle")
  amount             Decimal                          @db.Decimal(12, 2)
  paymentMethod      String                           @map("payment_method")
  transactionRef     String                           @map("transaction_ref")
  provider           String?
  providerReference  String?                          @map("provider_reference")
  checkoutUrl        String?                          @map("checkout_url")
  payerPhone         String?                          @map("payer_phone")
  note               String?
  status             SubscriptionPaymentRequestStatus @default(PENDING)
  reviewedBy         String?                          @map("reviewed_by")
  reviewedAt         DateTime?                        @map("reviewed_at")
  reviewNote         String?                          @map("review_note")
  paidUntil          DateTime?                        @map("paid_until")
  createdAt          DateTime                         @default(now()) @map("created_at")
  updatedAt          DateTime                         @updatedAt @map("updated_at")

  pharmacy           Pharmacy                         @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  requester          User                             @relation("SubscriptionPaymentRequestCreatedBy", fields: [requestedBy], references: [id], onDelete: Restrict)
  reviewer           User?                            @relation("SubscriptionPaymentRequestReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([pharmacyId, status, createdAt], map: "subscription_payment_requests_pharmacy_status_created_idx")
  @@index([status, createdAt], map: "subscription_payment_requests_status_created_idx")
  @@unique([pharmacyId, transactionRef], map: "subscription_payment_requests_pharmacy_transaction_ref_key")
  @@map("subscription_payment_requests")
}

model PharmacyMembership {
  id         String                 @id @default(uuid())
  userId     String                 @map("user_id")
  pharmacyId String                 @map("pharmacy_id")
  role       PharmacyMembershipRole
  active     Boolean                @default(true)
  validFrom  DateTime?              @map("valid_from")
  validUntil DateTime?              @map("valid_until")
  createdBy  String?                @map("created_by")
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")

  user     User     @relation("UserPharmacyMemberships", fields: [userId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  creator  User?    @relation("PharmacyMembershipCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([userId, pharmacyId], map: "pharmacy_memberships_user_pharmacy_key")
  @@index([pharmacyId, active, validUntil], map: "pharmacy_memberships_pharmacy_active_valid_until_idx")
  @@index([userId, active, validUntil], map: "pharmacy_memberships_user_active_valid_until_idx")
  @@map("pharmacy_memberships")
}

model PharmacySetting {
  id         String   @id @default(uuid())
  pharmacyId String   @map("pharmacy_id")
  key        String
  value      Json
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  creator  User     @relation("PharmacySettingCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([pharmacyId, key], map: "pharmacy_settings_pharmacy_key_key")
  @@index([pharmacyId], map: "pharmacy_settings_pharmacy_id_idx")
  @@map("pharmacy_settings")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model Product {
  id                     String     @id @default(uuid())
  pharmacyId             String
  name                   String
  genericName            String?
  brandName              String?
  sku                    String?
  barcode                String?
  dosageForm             DosageForm @default(TABLET)
  strength               String?
  unitOfMeasure          String     @default("unit")
  unitOfMeasureId        String?    @map("unit_of_measure_id")
  drugClass              DrugClass  @default(OTC)
  description            String?
  reorderLevel           Int        @default(10)
  sellingPrice           Decimal?   @db.Decimal(12, 2)
  tmda                   String?
  tmdaRegistrationNumber String?    @map("tmda_registration_number")
  coldChainRequired      Boolean    @default(false) @map("cold_chain_required")
  storageCondition       String     @default("AMBIENT") @map("storage_condition")
  retailStock            Boolean    @default(true) @map("retail_stock")
  wholesaleStock         Boolean    @default(false) @map("wholesale_stock")
  wholesaleSellingPrice  Decimal?   @map("wholesale_selling_price") @db.Decimal(12, 2)
  manufacturer           String?
  therapeuticCategory    String?    @map("therapeutic_category")
  isActive               Boolean    @default(true)
  drugMasterId           String?    @map("drug_product_id")
  lastSupplierId         String?    @map("last_supplier_id")
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  pharmacy                   Pharmacy                    @relation(fields: [pharmacyId], references: [id])
  drugMaster                 DrugProduct?                @relation(fields: [drugMasterId], references: [id])
  uom                        UnitOfMeasure?              @relation(fields: [unitOfMeasureId], references: [id], onDelete: SetNull)
  lastSupplier               Supplier?                   @relation("ProductLastSupplier", fields: [lastSupplierId], references: [id], onDelete: SetNull)
  batches                    Batch[]
  stockMovements             StockMovement[]
  stockAdjustmentSuggestions StockAdjustmentSuggestion[]
  barcodeMappings            ProductBarcodeMapping[]
  barcodeScanTelemetry       BarcodeScanTelemetry[]
  coldChainLogs              ColdChainLog[]
  stockOrderItems            StockOrderItem[]
  supplierCatalogueItems     SupplierCatalogueItem[]     @relation("SupplierCatalogueItemProduct")

  @@index([pharmacyId, barcode], map: "products_pharmacy_barcode_idx")
  @@index([pharmacyId, isActive, name], map: "products_pharmacy_active_name_idx")
  @@index([pharmacyId, sku], map: "products_pharmacy_sku_idx")
  @@index([drugMasterId], map: "products_drug_product_id_idx")
  @@index([lastSupplierId], map: "products_last_supplier_id_idx")
  @@index([unitOfMeasureId], map: "products_unit_of_measure_id_idx")
  @@map("products")
}

model ProductBarcodeMapping {
  id                   String   @id @default(uuid())
  pharmacyId           String   @map("pharmacy_id")
  barcode              String
  productId            String   @map("product_id")
  source               String
  gs1Payload           Json?    @map("gs1_payload")
  // Network sharing — when true this mapping is visible to all pharmacies as a
  // suggested auto-fill during stock intake. networkConfirmations increments each
  // time a second pharmacy accepts this mapping without correction, building
  // confidence in the data quality. Only OWNERs and PICs can set sharedToNetwork.
  sharedToNetwork      Boolean  @default(false) @map("shared_to_network")
  networkConfirmations Int      @default(0) @map("network_confirmations")
  createdBy            String   @map("created_by")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  creator  User     @relation("ProductBarcodeMappingCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([pharmacyId, barcode], map: "product_barcode_mappings_pharmacy_barcode_key")
  @@index([productId], map: "product_barcode_mappings_product_id_idx")
  @@index([barcode, sharedToNetwork], map: "product_barcode_mappings_barcode_shared_idx")
  @@map("product_barcode_mappings")
}

model BarcodeScanTelemetry {
  id               String   @id @default(uuid())
  pharmacyId       String   @map("pharmacy_id")
  barcode          String
  source           String
  result           String
  matchedProductId String?  @map("matched_product_id")
  metadata         Json?
  createdBy        String   @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [matchedProductId], references: [id], onDelete: SetNull)
  creator  User     @relation("BarcodeScanTelemetryCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([pharmacyId, createdAt], map: "barcode_scan_telemetry_pharmacy_created_at_idx")
  @@index([source, result], map: "barcode_scan_telemetry_source_result_idx")
  @@map("barcode_scan_telemetry")
}

model ColdChainLog {
  id           String   @id @default(uuid())
  pharmacyId   String   @map("pharmacy_id")
  productId    String?  @map("product_id")
  loggedBy     String   @map("logged_by")
  temperatureC Decimal  @map("temperature_c") @db.Decimal(5, 2)
  storageUnit  String?  @map("storage_unit")
  excursion    Boolean  @default(false)
  notes        String?
  loggedAt     DateTime @default(now()) @map("logged_at")
  createdAt    DateTime @default(now()) @map("created_at")

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  logger   User     @relation(fields: [loggedBy], references: [id], onDelete: Restrict)

  @@index([pharmacyId, loggedAt], map: "cold_chain_logs_pharmacy_logged_at_idx")
  @@map("cold_chain_logs")
}

model AiCounsellingCache {
  id             String   @id @default(uuid())
  pharmacyId     String   @map("pharmacy_id")
  ruleKey        String   @map("rule_key")
  severity       String
  drugName       String   @map("drug_name")
  flagsHash      String   @map("flags_hash")
  flags          Json
  suggestionText String   @map("suggestion_text")
  source         String   @default("RULE_TEMPLATE")
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  creator  User     @relation("AiCounsellingCacheCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([pharmacyId, ruleKey, severity, drugName, flagsHash], map: "ai_counselling_cache_unique_rule")
  @@index([pharmacyId, createdAt], map: "ai_counselling_cache_pharmacy_created_at_idx")
  @@map("ai_counselling_cache")
}

model FeatureTelemetry {
  id         String   @id @default(uuid())
  pharmacyId String   @map("pharmacy_id")
  featureKey String   @map("feature_key")
  eventType  String   @map("event_type")
  metadata   Json?
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  creator  User     @relation("FeatureTelemetryCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([pharmacyId, createdAt], map: "feature_telemetry_pharmacy_created_at_idx")
  @@index([featureKey, eventType], map: "feature_telemetry_feature_event_idx")
  @@map("feature_telemetry")
}

model Batch {
  id                String   @id @default(uuid())
  productId         String
  pharmacyId        String
  batchNumber       String
  expiryDate        DateTime
  quantityRemaining Int
  purchasePrice     Decimal  @db.Decimal(12, 2)
  supplierId        String?
  receivedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product                    Product                     @relation(fields: [productId], references: [id])
  pharmacy                   Pharmacy                    @relation(fields: [pharmacyId], references: [id])
  supplier                   Supplier?                   @relation(fields: [supplierId], references: [id])
  stockMovements             StockMovement[]
  stockAdjustmentSuggestions StockAdjustmentSuggestion[]

  @@index([pharmacyId, expiryDate, receivedAt], map: "batches_pharmacy_expiry_received_idx")
  @@index([pharmacyId, productId, quantityRemaining], map: "batches_pharmacy_product_quantity_idx")
  @@map("batches")
}

model StockAdjustmentSuggestion {
  id                    String    @id @default(uuid())
  pharmacyId            String    @map("pharmacy_id")
  productId             String    @map("product_id")
  batchId               String?   @map("batch_id")
  quantityDelta         Int       @map("quantity_delta")
  reason                String
  note                  String?
  photoPath             String?   @map("photo_path")
  status                String    @default("PENDING")
  createdBy             String    @map("created_by")
  reviewedBy            String?   @map("reviewed_by")
  approvedQuantityDelta Int?      @map("approved_quantity_delta")
  reviewNote            String?   @map("review_note")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  reviewedAt            DateTime? @map("reviewed_at")

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch    Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  creator  User     @relation("StockAdjustmentSuggestionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  reviewer User?    @relation("StockAdjustmentSuggestionReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([pharmacyId, status], map: "stock_adjustment_suggestions_pharmacy_status_idx")
  @@index([productId, createdAt], map: "stock_adjustment_suggestions_product_created_at_idx")
  @@map("stock_adjustment_suggestions")
}

model Supplier {
  id                             String   @id @default(uuid())
  pharmacyId                     String
  name                           String
  contactName                    String?
  phone                          String?
  email                          String?
  address                        String?
  isActive                       Boolean  @default(true)
  isApotekNetworkWholesaler      Boolean  @default(false) @map("is_apotek_network_wholesaler")
  wholesalerPharmacyId           String?  @map("wholesaler_pharmacy_id")
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  pharmacy                Pharmacy                  @relation(fields: [pharmacyId], references: [id])
  wholesalerPharmacy    Pharmacy?                  @relation("WholesalerSuppliers", fields: [wholesalerPharmacyId], references: [id], onDelete: SetNull)
  batches               Batch[]
