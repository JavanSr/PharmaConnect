// -- Supplier Portal (Tier 2 wholesaler tokenized confirmation) ----------------

enum SupplierPortalStatus {
  PENDING
  VIEWED
  CONFIRMED
  PARTIALLY_CONFIRMED
  REJECTED
  EXPIRED
}

model SupplierPortalToken {
  id            String               @id @default(uuid())
  token         String               @unique @default(uuid())
  stockOrderId  String               @unique @map("stock_order_id")
  pharmacyId    String               @map("pharmacy_id")
  pharmacyName  String               @map("pharmacy_name")
  supplierName  String               @map("supplier_name")
  supplierPhone String?              @map("supplier_phone")
  supplierEmail String?              @map("supplier_email")
  status        SupplierPortalStatus @default(PENDING)
  supplierNotes String?              @map("supplier_notes")
  deliveryDate  DateTime?            @map("delivery_date")
  viewedAt      DateTime?            @map("viewed_at")
  respondedAt   DateTime?            @map("responded_at")
  expiresAt     DateTime             @map("expires_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  stockOrder StockOrder               @relation(fields: [stockOrderId], references: [id], onDelete: Cascade)
  pharmacy   Pharmacy                 @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  lineItems  SupplierPortalLineItem[]

  @@map("supplier_portal_tokens")
}

model SupplierPortalLineItem {
  id                String   @id @default(uuid())
  tokenId           String   @map("token_id")
  stockOrderItemId  String   @map("stock_order_item_id")
  productName       String   @map("product_name")
  genericName       String?  @map("generic_name")
  strength          String?
  dosageForm        String?  @map("dosage_form")
  quantityRequested Int      @map("quantity_requested")
  quantityConfirmed Int?     @map("quantity_confirmed")
  unitPrice         Decimal? @map("unit_price") @db.Decimal(12, 2)
  available         Boolean  @default(true)
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  token          SupplierPortalToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  stockOrderItem StockOrderItem      @relation(fields: [stockOrderItemId], references: [id], onDelete: Cascade)

  @@map("supplier_portal_line_items")
}

// ─── B2B Pharmacy Links ───────────────────────────────────────────────────────

model PharmacyLink {
  id              String             @id @default(uuid())
  retailId        String             @map("retail_id")
  wholesaleId     String             @map("wholesale_id")
  status          PharmacyLinkStatus @default(PENDING)
  requestedBy     String             @map("requested_by")
  respondedBy     String?            @map("responded_by")
  rejectionReason String?            @map("rejection_reason")
  dissolvedBy     String?            @map("dissolved_by")
  dissolvedAt     DateTime?          @map("dissolved_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  retail    Pharmacy @relation("RetailLinks", fields: [retailId], references: [id], onDelete: Cascade)
  wholesale Pharmacy @relation("WholesaleLinks", fields: [wholesaleId], references: [id], onDelete: Cascade)

  @@unique([retailId, wholesaleId])
  @@map("pharmacy_links")
}

// ─── Wholesale Disputes (delivery discrepancy records) ────────────────────────

model WholesaleDispute {
  id               String        @id @default(uuid())
  orderId          String        @map("order_id")
  buyerPharmacyId  String        @map("buyer_pharmacy_id")
  sellerPharmacyId String        @map("seller_pharmacy_id")
  status           DisputeStatus @default(OPEN)
  description      String
  resolution       String?
  reportedBy       String        @map("reported_by")
  resolvedBy       String?       @map("resolved_by")
  resolvedAt       DateTime?     @map("resolved_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  lineItems WholesaleDisputeItem[]

  @@map("wholesale_disputes")
}

model WholesaleDisputeItem {
  id               String   @id @default(uuid())
  disputeId        String   @map("dispute_id")
  productId        String   @map("product_id")
  productName      String   @map("product_name")
  quantityOrdered  Int      @map("quantity_ordered")
  quantityReceived Int      @map("quantity_received")
  quantityDisputed Int      @map("quantity_disputed")
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  dispute WholesaleDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@map("wholesale_dispute_items")
}

// ─── Subscription Invoices ────────────────────────────────────────────────────

model SubscriptionInvoice {
  id               String                    @id @default(uuid())
  pharmacyId       String                    @map("pharmacy_id")
  paymentRequestId String?                   @map("payment_request_id")
  invoiceNumber    String                    @unique @map("invoice_number")
  periodFrom       DateTime                  @map("period_from")
  periodTo         DateTime                  @map("period_to")
  tier             SubscriptionTier
  billingCycle     BillingCycle              @map("billing_cycle")
  subtotal         Decimal                   @db.Decimal(12, 2)
  status           SubscriptionInvoiceStatus @default(DRAFT)
  issuedAt         DateTime?                 @map("issued_at")
  paidAt           DateTime?                 @map("paid_at")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@map("subscription_invoices")
}
