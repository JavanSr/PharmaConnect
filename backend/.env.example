# ── Database (Supabase / Railway PostgreSQL) ───────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV="development"
FRONTEND_URL="https://pharma-connect-rouge.vercel.app"

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:5173,https://pharma-connect-rouge.vercel.app"

# ── File uploads ───────────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5

# Required for AI-assisted catalogue import (optional - rest of app works without it)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Supabase Storage (optional, used for private compliance document / PDF storage)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Optional email delivery for waitlist confirmations and digests
RESEND_API_KEY="re_xxx"
FOUNDER_EMAIL="elihaki.yusuph@gmail.com"
RESEND_FROM_EMAIL="PharmaConnect <no-reply@pharmaconnect.tz>"
AFRICAS_TALKING_API_KEY=""
AFRICAS_TALKING_USERNAME="sandbox"
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
VFD_API_URL=""
VFD_API_TOKEN=""

# ── AzamPay (subscription payments — MNO STK push) ────────────────────────────
# From the AzamPay dashboard. Checkout returns 503 AZAMPAY_NOT_CONFIGURED without these.
AZAMPAY_APP_NAME="APOTEKH"
AZAMPAY_CLIENT_ID=""
AZAMPAY_CLIENT_SECRET=""
# "sandbox" or "production"
AZAMPAY_ENVIRONMENT="sandbox"
# Shared secret authenticating the payment callback. Generate a long random value,
# then register the callback URL in the AzamPay dashboard as:
#   https://<backend>/api/v1/azampay/callback?secret=<this value>
# Unset = callback accepts unauthenticated POSTs (logged loudly; do NOT ship prod without it).
AZAMPAY_CALLBACK_SECRET=""

# ── Subscription checkout (optional) ──────────────────────────────────────────
# Fallback hosted-checkout URL template used when AzamPay is not configured.
# Placeholders: {reference} {amount} {tier} {billingCycle} {payerPhone}
SUBSCRIPTION_PAYMENT_LINK_TEMPLATE=""
SUBSCRIPTION_PAYMENT_PROVIDER="mobile_money"
SUBSCRIPTION_PAYMENT_WEBHOOK_SECRET=""
